# Demo-only integration credentials. Do not reuse these outside the local Docker lab.
POSTGRES_USER=nodeflow
POSTGRES_PASSWORD=nodeflow
POSTGRES_DB=nodeflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MONGODB_URI=mongodb://mongodb:27017/nodeflow
REDIS_URL=redis://redis:6379

RABBITMQ_USER=nodeflow
RABBITMQ_PASSWORD=nodeflow
RABBITMQ_URL=amqp://nodeflow:nodeflow@rabbitmq:5672

RISK_SERVICE_URL=http://mock-risk-service:3100

# Optional NodeFlow V2 collector overrides.
NODEFLOW_EXPORT_PROTOCOL=protobuf
NODEFLOW_WORKERS=8
NODEFLOW_QUEUE_SIZE=10000
NODEFLOW_BATCH_SIZE=250
NODEFLOW_FLUSH_INTERVAL=500ms
