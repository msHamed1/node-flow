# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS dashboard

WORKDIR /workspace
RUN corepack enable && corepack prepare yarn@1.22.22 --activate
COPY package.json yarn.lock tsconfig.base.json ./
COPY protocol ./protocol
COPY dashboard ./dashboard
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn \
    yarn install --frozen-lockfile \
    && yarn workspace @mshamed1/node-flow-protocol build \
    && yarn workspace @mshamed1/node-flow-dashboard build

FROM golang:1.24-alpine AS build

WORKDIR /src
COPY runtime/go/go.mod runtime/go/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY runtime/go/ ./
ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/nodeflow-collector ./cmd/nodeflow-collector

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
    && mkdir -p /var/lib/nodeflow/spool /var/lib/nodeflow/topology-state \
    && chown -R 65532:65532 /var/lib/nodeflow
COPY --from=build /out/nodeflow-collector /usr/local/bin/nodeflow-collector
COPY --from=dashboard /workspace/dashboard/dist /usr/share/nodeflow/dashboard
USER 65532:65532
EXPOSE 4318 7331
HEALTHCHECK --interval=5s --timeout=2s --retries=12 \
  CMD wget -q -O /dev/null http://127.0.0.1:4318/readyz || exit 1
ENTRYPOINT ["/usr/local/bin/nodeflow-collector"]
