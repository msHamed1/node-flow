{
  "name": "node-flow-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "cli",
    "dashboard",
    "examples/*",
    "protocol",
    "reference/*",
    "runtime/npm/*",
    "sdk/*",
    "tests/integration/*"
  ],
  "scripts": {
    "build": "yarn workspace @mshamed1/node-flow-protocol build && yarn workspace @mshamed1/node-flow-integration-contracts build && yarn workspace @mshamed1/node-flow-topology-engine build && yarn workspace @mshamed1/node-flow-core build && yarn workspace @mshamed1/node-flow-instrumentation-node build && yarn workspace @mshamed1/node-flow-instrumentation-nestjs build && yarn workspace @mshamed1/node-flow-dashboard build && yarn workspace @mshamed1/node-flow-collector build && yarn runtime:build && yarn workspace @mshamed1/node-flow build && yarn workspace @mshamed1/node-flow-demo-nestjs build && yarn workspace @mshamed1/node-flow-mock-risk-service build && yarn workspace @mshamed1/node-flow-integration-api build && yarn workspace @mshamed1/node-flow-integration-worker build",
    "test": "vitest run",
    "test:golden": "vitest run reference/topology/test/golden-corpus.test.ts",
    "test:topology-diff": "vitest run reference/topology/test/go-differential.test.ts",
    "benchmark:topology": "yarn workspace @mshamed1/node-flow-topology-engine build && node --expose-gc scripts/benchmark-topology.mjs",
    "test:watch": "vitest",
    "lint": "node scripts/run-workspace-script.mjs lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "yarn build && node cli/dist/cli.js dev -- node examples/nestjs/dist/main.js",
    "demo:traffic": "node scripts/generate-demo-traffic.mjs",
    "clean": "node scripts/run-workspace-script.mjs clean && yarn runtime:clean",
    "runtime:build": "node scripts/build-runtime-packages.mjs",
    "runtime:build:current": "node scripts/build-runtime-packages.mjs --current",
    "runtime:check:current": "node scripts/verify-runtime-package.mjs",
    "runtime:smoke:launcher": "node scripts/smoke-runtime-launcher.mjs",
    "runtime:clean": "node scripts/build-runtime-packages.mjs --clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn release:check && changeset publish",
    "release:check": "node scripts/check-release-readiness.mjs",
    "scope:check": "node scripts/check-scope-migration.mjs",
    "package:check": "node scripts/check-packages.mjs",
    "package:smoke": "node scripts/smoke-packed-package.mjs",
    "integration:up": "docker compose up -d --build --wait --wait-timeout 240",
    "integration:down": "docker compose down -v --remove-orphans",
    "integration:test": "node scripts/integration-test.mjs",
    "integration:durability": "node scripts/durable-recovery-test.mjs",
    "integration:logs": "docker compose logs -f nodeflow-collector nodeflow-typescript-rollback integration-api integration-worker mock-risk-service",
    "integration": "yarn integration:up && yarn integration:test && yarn integration:durability",
    "proto:generate": "scripts/generate-protocol.sh",
    "proto:check": "yarn proto:generate && git diff --exit-code -- runtime/go/gen",
    "go:build": "cd runtime/go && go build ./...",
    "go:test": "cd runtime/go && go test ./...",
    "go:race": "cd runtime/go && go test -race ./...",
    "go:vet": "cd runtime/go && go vet ./...",
    "go:benchmark": "cd runtime/go && go test -run '^$' -bench BenchmarkPipeline -benchmem ./internal/pipeline",
    "go:benchmark:topology": "cd runtime/go && go test -run '^$' -bench 'BenchmarkTopology' -benchmem ./internal/topology"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msHamed1/node-flow.git"
  },
  "homepage": "https://github.com/msHamed1/node-flow#readme",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
