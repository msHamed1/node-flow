{
  "name": "@mshamed1/node-flow-instrumentation-node",
  "version": "1.0.0",
  "description": "OpenTelemetry preload, runtime metrics, and local exporter for NodeFlow.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msHamed1/node-flow.git",
    "directory": "packages/instrumentation-node"
  },
  "homepage": "https://github.com/msHamed1/node-flow#readme",
  "bugs": {
    "url": "https://github.com/msHamed1/node-flow/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./register": "./dist/register.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mshamed1/node-flow-protocol": "1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/instrumentation-amqplib": "^0.50.0",
    "@opentelemetry/instrumentation-express": "^0.52.0",
    "@opentelemetry/instrumentation-http": "^0.203.0",
    "@opentelemetry/instrumentation-mongodb": "^0.56.0",
    "@opentelemetry/instrumentation-mongoose": "^0.50.0",
    "@opentelemetry/instrumentation-pg": "^0.56.1",
    "@opentelemetry/instrumentation-redis": "^0.52.0",
    "@opentelemetry/instrumentation-undici": "^0.14.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.32.0"
  }
}
